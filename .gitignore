# dist_keycloak/ SÍ se versiona — el .jar compilado se commit desde la PC
# para que el server NO necesite Node.js instalado (lo toma del repo)

# ---- Secretos: NO al remote (mientras estemos en GitHub) -------------------
# Cuando migremos a GitLab privado, removemos esto y activamos git-crypt
# (las reglas ya están en .gitattributes, dormidas hasta entonces).
.env
**/.env
**/.env.docker
**/.env.local

# Excepciones: templates con placeholders (sin secretos) sí se versionan
!.env.example
!**/.env.example
!**/.env.docker.example
!**/.env.local.example

