# dist_keycloak/ SÍ se versiona — el .jar compilado se commit desde la PC
# para que el server NO necesite Node.js instalado (lo toma del repo)

# ---- Datos persistentes (bind mounts de Docker) ----------------------------
# Todo lo que viva en data/ se ignora EXCEPTO la carpeta de backups
# (dumps de DB versionables) y los .gitkeep que mantienen estructura.
data/*
!data/backups/
!data/.gitkeep

data/backups/*
!data/backups/.gitkeep
