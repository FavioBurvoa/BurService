# ============================================================================
# SAGA OPS — VARIABLES DE COMPOSE (raíz)
# ============================================================================
# Copia este archivo a `.env` y completa los valores. El `.env` real está
# cifrado con git-crypt y NO debe commitearse en plano.
# ============================================================================

# Carpeta física donde viven todos los volúmenes persistentes.
# Recomendado: ./data (relativo al repo)
DATA_DIR=./data

# IP del server en la LAN (informativo, sirve para /etc/hosts en dispositivos)
LAN_IP=192.168.1.50

# ----------------------------------------------------------------------------
# Postgres — DB principal de Saga Ops
# ----------------------------------------------------------------------------
DB_NAME=burservice
DB_USER=postgres
DB_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Postgres — DB exclusiva de Keycloak
# ----------------------------------------------------------------------------
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
KC_DB_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Keycloak — credenciales de bootstrap del admin
# ----------------------------------------------------------------------------
KC_ADMIN=admin
KC_ADMIN_PASSWORD=changeme
