# ============================================================================
# API (Node Express) — variables del CONTAINER
# ============================================================================
# Estos valores se usan SOLO cuando `api` corre dentro de docker-compose.
# Para `npm run dev` local sigue usándose `api/.env`.
# ============================================================================

PORT=3001
NODE_ENV=production

# Postgres — accedido por hostname de servicio en la red Docker
DB_HOST=postgres
DB_PORT=5432
DB_NAME=burservice
DB_USER=postgres
DB_PASSWORD=postgres

# Keycloak — JWKS lo fetcheamos por la red interna (más rápido, sin TLS).
# El ISSUER debe ser el dominio público porque es lo que aparece en el `iss`
# del JWT que llega del browser.
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/saga-ops/protocol/openid-connect/certs
KEYCLOAK_ISSUER=https://auth.burservce.cl/realms/saga-ops

# CORS — origin del frontend público
CORS_ORIGIN=https://app.burservce.cl
