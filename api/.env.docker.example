# ============================================================================
# API (Node Express) — variables del CONTAINER (TEMPLATE)
# ============================================================================
# Copiar a `api/.env.docker` y completar.
# El `.env.docker` real está en .gitignore — NO se commitea.
#
# Estos valores se usan SOLO cuando `api` corre dentro de docker-compose.
# Para `npm run dev` local sigue usándose `api/.env`.
# ============================================================================

PORT=3001
NODE_ENV=production

# ----------------------------------------------------------------------------
# Postgres — accedido por hostname de servicio en la red Docker
# ----------------------------------------------------------------------------
DB_HOST=postgres
DB_PORT=5432
DB_NAME=burservice
DB_USER=postgres
DB_PASSWORD=changeme

# ----------------------------------------------------------------------------
# Keycloak
# ----------------------------------------------------------------------------
# JWKS se fetchea por red interna (más rápido, sin TLS overhead)
KEYCLOAK_JWKS_URL=http://keycloak:8080/realms/saga-ops/protocol/openid-connect/certs

# ISSUER debe ser el dominio público — coincide con el `iss` del JWT del browser
KEYCLOAK_ISSUER=https://auth.burservce.cl/realms/saga-ops

# ----------------------------------------------------------------------------
# CORS
# ----------------------------------------------------------------------------
CORS_ORIGIN=https://app.burservce.cl
